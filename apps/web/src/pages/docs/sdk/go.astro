---
const snippet = `go get github.com/nicebear/nicebear-go

c := nicebear.New("https://api.nicebear.dev", "nb_live_...")
println(c.AvatarURL("av_123", "john", nil))
col, _ := c.CreateCollection("team-avatars", "pixel-art", "")
av, _ := c.CreateAvatar(map[string]any{
    "collection_id": col["id"],
    "type": "generated",
    "engine": "pixel-art",
})
println(av["id"])`;
