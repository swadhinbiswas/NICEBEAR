---
import { Login } from "../islands/Login";

// Server-side: only offer GitHub when OAuth is configured (no dead button).
const rt = (Astro.locals as unknown as { runtime?: { env?: Record<string, unknown> } })?.runtime?.env ?? {};
const proc = (globalThis as unknown as { process?: { env?: Record<string, string | undefined> } }).process;
const githubOn = Boolean(rt["GITHUB_CLIENT_ID"] ?? proc?.env?.["GITHUB_CLIENT_ID"]);
const next = Astro.url.searchParams.get("next") ?? "/dashboard";
---

<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Sign in — NiceBear</title></head>
  <body style="margin:0;background:#09090b;color:#f4f4f5;font-family:ui-sans-serif,system-ui,sans-serif">
    <Login githubOn={githubOn} next={next} client:load />
  </body>
</html>
