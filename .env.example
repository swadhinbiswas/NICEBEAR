TURSO_DATABASE_URL=libsql://localhost:8080
TURSO_AUTH_TOKEN=
# Asset store (pick one):
# - github (default): GitHub Contents API + jsDelivr. Needs ?repo= per upload
#   and GITHUB_TOKEN.
# - hf: Hugging Face Storage Buckets via the S3 gateway. Needs the HF_* vars
#   below; versions live in per-version object keys, served via the Hub CDN.
ASSET_STORE=github
GITHUB_TOKEN=
HF_NAMESPACE=
HF_BUCKET=
HF_S3_ACCESS_KEY_ID=HFAK...
HF_S3_SECRET_ACCESS_KEY=
# Optional override for the public read base (default:
# https://huggingface.co/buckets/<ns>/<bucket>/resolve/main).
# HF_PUBLIC_BASE_URL=
CLOUDFLARE_API_TOKEN=
# Donations (optional): NiceBear is free forever with no paid plans. Set this
# to your sponsors/donations page URL to show a donate button on /support.
# Leave unset to hide the button.
# DONATE_URL=https://github.com/sponsors/your-name
# Auth (Better Auth): required in production; dev falls back to an insecure
# local secret with a warning. URL must match the deployed origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
# GitHub OAuth (optional; email/password always on). Doubles as the
# asset-repo connection flow (§1).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
