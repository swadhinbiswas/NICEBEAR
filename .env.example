# local secret with a warning. URL must match the deployed origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
# GitHub OAuth (optional; email/password always on). Doubles as the
# asset-repo connection flow (§1).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
